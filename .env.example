# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://runner:runner@localhost:5432/route_planner?schema=public"

# Optional: OpenRouteService API key (free tier at https://openrouteservice.org/dev/#/signup)
# Without this, the app falls back to a synthetic geometric route generator
# so the MVP works out of the box with zero API keys.
ORS_API_KEY=""

# Optional: override the demo starting location (defaults to Singapore)
NEXT_PUBLIC_DEFAULT_LAT="1.3048"
NEXT_PUBLIC_DEFAULT_LNG="103.8318"
